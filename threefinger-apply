#!/usr/bin/env bash
# Install or update the Hyprland side of 3 Finger Gestures from a settings
# object, then reload Hyprland. The bar widget runs this whenever a setting
# changes; you can also run it yourself.
#   threefinger-apply '{"tray_max": 8}'     merge these keys over the defaults
#   threefinger-apply -                     same, JSON on stdin
#   threefinger-apply --defaults            just the defaults
#   threefinger-apply --print [json]        show the settings file, write nothing
set -euo pipefail
here=$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)
hypr="${THREEFINGER_HYPR_DIR:-$HOME/.config/hypr}"
state="$HOME/.local/state/omarchy"
for cmd in jq hyprctl; do command -v "$cmd" >/dev/null || { echo "threefinger-apply: '$cmd' not found" >&2; exit 1; }; done

print_only=0; input="{}"
case "${1:-}" in
  --print) print_only=1; input="${2:-{\}}" ;;
  --defaults|"") input="{}" ;;
  -) input=$(cat) ;;
  *) input="$1" ;;
esac
defaults=$(jq -c '.barWidget.defaults' "$here/manifest.json")
merged=$(jq -c --argjson d "$defaults" --argjson u "$input" '$d * ($u | with_entries(select(.value != null)))' <<<"{}")

# Settings JSON -> Lua table. Numbers and booleans pass through; strings that
# look like numbers or booleans (as `omarchy bar set` stores them) are
# converted; other strings are quoted; "none" for the tray key means no key.
lua_settings=$(jq -r '
  def lua: if type == "boolean" or type == "number" then tostring
           elif type == "string" and (. == "true" or . == "false") then .
           elif type == "string" and test("^-?[0-9]+(\\.[0-9]+)?$") then .
           elif . == "none" or . == "" then "false"
           else tojson end;
  "-- Generated by threefinger-apply from the 3 Finger Gestures bar widget.",
  "-- Change settings from the bar widget or with:",
  "--   omarchy bar set threefinger.gestures <key> <value>",
  "-- Edits here are overwritten the next time a setting changes.",
  "return {",
  (to_entries[] | "  \(.key) = \(.value | lua),"),
  "}"' <<<"$merged")

if [[ $print_only -eq 1 ]]; then printf '%s\n' "$lua_settings"; exit 0; fi

mkdir -p "$hypr" "$state"
stamp=$(date +%s)
for f in minimize.lua gestures.lua; do
  if [[ -f "$hypr/$f" ]] && ! cmp -s "$here/hypr/$f" "$hypr/$f"; then
    # Keep one backup of a hand-edited or older copy, not one per run.
    grep -q "threefinger.gestures\|omarchy-3-finger-gestures" "$hypr/$f" || cp "$hypr/$f" "$hypr/$f.bak.$stamp"
  fi
  install -m 644 "$here/hypr/$f" "$hypr/$f"
done
tmp=$(mktemp "$hypr/.gestures-settings.XXXXXX"); printf '%s\n' "$lua_settings" > "$tmp"; chmod 644 "$tmp"; mv -f "$tmp" "$hypr/gestures-settings.lua"
"$here/threefinger-require" >/dev/null

if ! hyprctl reload >/dev/null 2>&1; then
  echo "threefinger-apply: could not reach Hyprland to reload (is it running?)" >&2; exit 1
fi
if ! errors=$(hyprctl configerrors 2>/dev/null); then
  echo "threefinger-apply: could not ask Hyprland for config errors" >&2; exit 1
fi
if [[ -n "$errors" && "$errors" != "ok" ]]; then
  echo "threefinger-apply: Hyprland reported config errors:" >&2; echo "$errors" >&2; exit 1
fi
echo "threefinger-apply: applied $(jq -c . <<<"$merged")"
